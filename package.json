{
  "name": "sfdxdatadicgen",
  "description": "Salesforce CLI plugin that generates a data dictionary from an org",
  "version": "1.0.0",
  "author": "Marcelo Marsson @marsson",
  "bugs": "https://github.com/marsson/dataDicGen/issues",
  "dependencies": {
    "@oclif/core": "^4.0.17",
    "@salesforce/core": "^8.5.7",
    "@salesforce/sf-plugins-core": "^11.3.10",
    "bytes": "^3.1.2",
    "d3": "^7.9.0",
    "excel4node": "^1.8.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@oclif/plugin-help": "^6.2.10",
    "@salesforce/cli-plugins-testkit": "^5.3.31",
    "@salesforce/dev-config": "^4.1.0",
    "@salesforce/ts-sinon": "^1.4.27",
    "@salesforce/ts-types": "^2.0.10",
    "@types/bytes": "^3.1.4",
    "@types/chai": "^4.3.19",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.16.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "eslint-config-salesforce": "^2.0.2",
    "eslint-config-salesforce-typescript": "^3.2.13",
    "mocha": "^10.7.3",
    "nyc": "^15.1.0",
    "oclif": "^4.14.32",
    "sinon": "^17.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/messages",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/marsson/dataDicGen",
  "keywords": [
    "force",
    "salesforce",
    "salesforcedx",
    "sf",
    "sf-plugin",
    "sfdx",
    "sfdx-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "exports": "./lib/index.js",
  "oclif": {
    "bin": "sf",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "data-dictionary": {
        "description": "Generate a data dictionary for a Salesforce org."
      }
    },
    "flexibleTaxonomy": true
  },
  "repository": "marsson/dataDicGen",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf lib oclif.manifest.json",
    "lint": "eslint src test --ext .ts",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run clean && npm run build && oclif manifest && oclif readme",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  }
}
